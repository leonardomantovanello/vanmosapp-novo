{
  "expo": {
    "name": "tcc-expo",
    "slug": "tcc-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tccexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vanmos.tccexpo",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O VanMos usa sua localização para compartilhar em tempo real a posição da van durante a corrida."
      }
    },
    "android": {
      "package": "com.vanmos.tccexpo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O VanMos usa sua localização para compartilhar em tempo real a posição da van durante a corrida."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O VanMos usa o microfone para gravar mensagens de áudio no chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O VanMos usa suas fotos para definir a imagem de perfil e enviar fotos no chat.",
          "cameraPermission": "O VanMos usa a câmera para tirar fotos e enviar no chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
