# Copy this file to `.env` (already git-ignored — never commit a real one)
# and point it at whichever VanMos backend you want this build to talk to.
# Read by app.config.js -> exposed as Constants.expoConfig.extra.apiBaseUrl
# -> services/api/client.ts.

# Local dev: Spring Boot running on your machine (default port 8080).
# Android emulator note: "localhost" from the emulator's perspective is the
# emulator itself, not your host machine — use http://10.0.2.2:8080/api
# instead when running against a local backend from an Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Render deployment — uncomment and replace <your-render-host> with the
# actual deployed hostname to point the app at staging/production instead.
# EXPO_PUBLIC_API_BASE_URL=https://<your-render-host>/api
